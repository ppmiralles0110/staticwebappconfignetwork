{
  "networking": {
    "allowedIpRanges": [
      "20.97.0.0/16"
    ]
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/images/*.{png,jpg,svg,ico}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Cache-Control": "no-store"
  }
}
